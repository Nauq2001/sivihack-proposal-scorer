# Copy file nay thanh .env va dien key that vao
AI_PROVIDER=gemini
GEMINI_API_KEY=your_key_here

# gemini-2.0-flash da bi go khoi API; ban moi nhat hien tai la gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# RFP Analyst: model va so lan thu lai khi model tra trich dan khong khop
# nguyen van (validate_analysis bao QUOTE_NOT_FOUND)
RFP_ANALYST_MODEL=gemini-3.8-flash
RFP_ANALYST_ATTEMPTS=3

# Du phong / doi provider
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
